#!/usr/bin/env python3
"""Offline CLI substitute: no network, isolated fixtures only."""

import json
import os
from pathlib import Path
import sys
import time

args = sys.argv[1:]
trace = Path(os.environ["DR_MOCK_TRACE"])
scenario = os.environ.get("DR_MOCK_SCENARIO", "normal")
if "--json-schema" not in args:
    print(
        json.dumps(
            {
                "is_error": scenario == "auth",
                "api_error_status": 401 if scenario == "auth" else None,
            }
        )
    )
    sys.exit(0)
payload = json.load(sys.stdin)
stage = "editorial" if "research" in payload else "research"
with trace.open("a") as f:
    f.write(
        json.dumps(
            {"stage": stage, "args": args, "payload": payload, "cwd": os.getcwd()}
        )
        + "\n"
    )
if scenario == "timeout":
    time.sleep(5)
if scenario == "transient" and stage == "research":
    marker = trace.with_suffix(".retry")
    if not marker.exists():
        marker.touch()
        print(
            json.dumps(
                {
                    "is_error": True,
                    "api_error_status": 503,
                    "result": "503 overloaded",
                    "total_cost_usd": 0.2,
                }
            )
        )
        sys.exit(1)
s = {
    "url": "https://example.org/study",
    "title": "Primary study",
    "published_at": None,
    "checked_at": payload["date"],
    "evidence": "Read the study text",
    "access": "verified",
}
if stage == "research":
    value = {
        "candidates": [
            {
                "title": "A different possibility",
                "possibility": "A new use",
                "evidence": "Observed example",
                "sources": [s],
            }
        ]
    }
else:
    quiet = scenario == "quiet"
    value = {
        "kind": "quiet" if quiet else "normal",
        "title": "Morning possibilities",
        "tags": ["discovery"],
        "main": None
        if quiet
        else {
            "title": "A different possibility",
            "body": "A directly sourced discovery.",
            "source_urls": [s["url"]],
        },
        "briefs": [],
        "sources": [] if quiet else [s],
        "opportunities": [],
    }
    if scenario == "invalid":
        value["main"]["source_urls"] = ["https://example.org/never-read"]
print(
    json.dumps(
        {
            "type": "result",
            "is_error": False,
            "structured_output": value,
            "total_cost_usd": 0.1,
            "num_turns": 2,
            "duration_ms": 100,
            "usage": {"input_tokens": 100, "output_tokens": 200},
        }
    )
)
